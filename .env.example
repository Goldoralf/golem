# GoleM — secrets locaux (copier en .env, qui est gitignored)
#   cp .env.example .env   puis colle ta clé ci-dessous

# Clé publishable TONE3000 (Settings → API Keys → t3k_pub_…)
# = le client_id OAuth (cf. docs/tone3000-api.md)
# vide = pas de clé : un golem relié à golem.fm n'en a pas besoin (relais TONE3000) ; sinon t3k_pub_…
T3K_PUBLISHABLE_KEY=

# Tokens OAuth (remplis automatiquement par tools/t3k quand on le construira) :
# T3K_ACCESS_TOKEN=
# T3K_REFRESH_TOKEN=

# Serveur golem.fm (golem.fm par défaut). En dev, le golem.fm local :
# GOLEM_SERVER_URL=http://localhost:5173
