  "phases": [
   {
    "name": "Wire it up",
    "steps": [
     {
      "title": "Cable",
      "do": "Plug the Volt 276 MIDI OUT into the Whammy DT MIDI IN.",
      "hint": "The pedal never answers on MIDI — the wire only goes one way."
     },
     {
      "title": "MIDI channel",
      "do": "The Whammy DT listens on channel 1 out of the box. golem sends on channel 1.",
      "hint": "If you changed it on the pedal, set the same number in this mapping."
     },
     {
      "title": "Kill the merge on the FCB1010",
      "do": "If your FCB1010 sits on the same chain, its MIDI MERGE must be OFF.",
      "hint": "Merge ON loops golem's own Whammy messages back in — page 3 of the FCB global setup."
     }
    ]
   }
  ]
 },
