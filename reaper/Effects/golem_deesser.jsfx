desc:GoleM De-esser
// SPDX-License-Identifier: MIT
// Copyright (C) 2026 Raphaël Mucchielli, Grégory Beurier and contributors
// Ce JSFX est sous MIT, PAS sous la GPL du depot : un effet doit pouvoir voyager seul.
// De-esser simple et musical pour la voix (bloc « deesser », tiroirs voix 2026-07-23).
// Principe split-band : HP 2 pôles à Freq -> détection RMS courte de la bande sibilante ;
// au-dessus du Threshold, la bande seule est atténuée (ratio fort), réduction plafonnée
// par Range. Le reste du spectre passe intact -> pas de pompage du bas.
// Listen = solo de la bande détectée (pour caler Freq à l'oreille).
// GR publiée via gain-reduction standard ? Non — JSFX ne rapporte pas GainReduction_dB à
// l'API : le DynMeter de la feuille montrera OUT seul (comme la gate, documenté).

slider1:-28<-50,0,0.5>Threshold (dB)
slider2:6000<2000,12000,50>Frequency (Hz)
slider3:10<0,24,0.5>Max Reduction (dB)
slider4:0<0,1,1{Off,On}>Listen (band)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
rms = 0;
gr_db = 0;

@slider
thresh = slider1;
freq = max(2000, min(12000, slider2));
range = slider3;
listen = slider4;
// HP Butterworth 2 pôles (RBJ), recalculé au slider seulement
w0 = 2 * $pi * freq / srate;
cw = cos(w0); sw = sin(w0);
q = 0.707;
alpha = sw / (2 * q);
b0 = (1 + cw) / 2; b1 = -(1 + cw); b2 = (1 + cw) / 2;
a0 = 1 + alpha; a1 = -2 * cw; a2 = 1 - alpha;
hb0 = b0 / a0; hb1 = b1 / a0; hb2 = b2 / a0; ha1 = a1 / a0; ha2 = a2 / a0;
// constantes de détection : attaque ~1 ms, relâche ~60 ms (sibilances = transitoires courts)
atk = exp(-1 / (0.001 * srate));
rel = exp(-1 / (0.060 * srate));

@sample
mono = 0.5 * (spl0 + spl1);
// bande sibilante (HP 12 dB/oct)
hp = hb0 * mono + hb1 * x1 + hb2 * x2 - ha1 * y1 - ha2 * y2;
x2 = x1; x1 = mono;
y2 = y1; y1 = hp;
// suiveur RMS-ish (crête lissée asymétrique)
lvl = abs(hp);
rms = lvl > rms ? atk * rms + (1 - atk) * lvl : rel * rms + (1 - rel) * lvl;
db = rms > 0.0000001 ? 8.6858896 * log(rms) : -120;
// au-delà du seuil : réduction = dépassement × pente (ratio ~6:1), plafonnée par Range
over = db - thresh;
gr_db = over > 0 ? min(range, over * (1 - 1/6)) : 0;
g = exp(-gr_db * 0.11512925);          // dB -> gain linéaire (10^(-gr/20))
// la bande seule est atténuée : out = full - band + band*g  (== full quand gr=0)
d0 = hp * (g - 1);
listen ? (
  spl0 = hp * g;
  spl1 = hp * g;
) : (
  spl0 = spl0 + d0;
  spl1 = spl1 + d0;
);

@gfx 220 40
gfx_r = 0.55; gfx_g = 0.6; gfx_b = 0.66; gfx_a = 1;
gfx_x = 6; gfx_y = 6;
gfx_drawstr("GR ");
gfx_x = 34; gfx_y = 8;
w = 160 * min(1, gr_db / 24);
gfx_r = 1; gfx_g = 0.35; gfx_b = 0.28;
gfx_rectto(gfx_x + w, gfx_y + 10);
