desc:GoleM Grit -- the grit block on Windows and macOS (Prisma parameters)
// SPDX-License-Identifier: MIT
// Copyright (C) 2026 Raphaël Mucchielli, Grégory Beurier and contributors
// Ce JSFX est sous MIT, PAS sous la GPL du depot : un effet doit pouvoir voyager seul.
//
// Le bloc « grit » joue Prisma (UnplugRed, AGPL) sous Linux, compile par provision/install-prisma.sh ; il n'y a pas
// de Prisma a installer sous Windows ni sous macOS (docs/platforms.md §5). Ce JSFX reprend son INTERFACE : les noms
// de parametres, la liste des 23 modules, 4 bandes x 2 modules, les crossovers (position 0..1 sur une echelle log
// 20 Hz - 20 kHz : f = 20 x 1000^x), le gain de bande ((2 g)^2 : 0,5 = 0 dB) et le module Gain ((v / 0,35)^2 :
// 0,35 = 0 dB) — des SENS de parametres, pour que les presets gardent leurs reglages et leurs niveaux.
// Le DSP de chaque module est le NOTRE, ecrit d'apres son nom : aucun code de Prisma n'est repris (AGPL). Le son
// est de la meme famille, pas identique.
//
// Modules (v = Value, 0..1) : Soft clip / Hard clip / Heavy / Asym = saturations de drive 1..30 (Heavy 1..100),
// compensees en niveau ; Rectify = redressement double alternance dose ; Fold / Sine fold = repliement ;
// Zero cross = distorsion de croisement ; Bit crush = 16 -> 1 bit ; Sample divide = echantillon tenu 1..64 fois ;
// DC = decalage (rend les modules suivants asymetriques, retire en fin de bande) ; Width = largeur stereo 0..2 ;
// Gain ; Pan ; Lowpass (20 kHz -> 20 Hz) ; Highpass (20 Hz -> 20 kHz) ; Peak = cloche +24 dB max au centre de la
// bande ; Dry/wet = retour vers le signal de la bande avant ses modules ; Stereo rectify (droite seule) ; Stereo DC
// (decalages opposes) ; Ring mod (porteuse 20 Hz -> 20 kHz) ; Cabinet = filtre de haut-parleur (90 Hz -> 6..1,5 kHz).
// Quality n'est la que pour le contrat de noms : ce JSFX ne surechantillonne jamais (latence nulle, comme Quality
// OFF, que le catalogue recommande en live).
//
// Pieges respectes (docs/pitfalls/jsfx.md) : rien avant @init ; variables prefixees gr_ ; ext_noinit ; srate relu
// dans @block ; aucun slider a minimum negatif.

slider1:gr_lo_m1=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>Low Module 1 Type
slider2:gr_lo_v1=0<0,1,0.001>Low Module 1 Value
slider3:gr_lo_m2=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>Low Module 2 Type
slider4:gr_lo_v2=0<0,1,0.001>Low Module 2 Value
slider5:gr_lo_g=0.5<0,1,0.001>Low Gain
slider6:gr_lm_m1=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>Low Mid Module 1 Type
slider7:gr_lm_v1=0<0,1,0.001>Low Mid Module 1 Value
slider8:gr_lm_m2=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>Low Mid Module 2 Type
slider9:gr_lm_v2=0<0,1,0.001>Low Mid Module 2 Value
slider10:gr_lm_g=0.5<0,1,0.001>Low Mid Gain
slider11:gr_hm_m1=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>High Mid Module 1 Type
slider12:gr_hm_v1=0<0,1,0.001>High Mid Module 1 Value
slider13:gr_hm_m2=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>High Mid Module 2 Type
slider14:gr_hm_v2=0<0,1,0.001>High Mid Module 2 Value
slider15:gr_hm_g=0.5<0,1,0.001>High Mid Gain
slider16:gr_hi_m1=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>High Module 1 Type
slider17:gr_hi_v1=0<0,1,0.001>High Module 1 Value
slider18:gr_hi_m2=0<0,22,1{Off,Soft clip,Hard clip,Heavy,Asym,Rectify,Fold,Sine fold,Zero cross,Bit crush,Sample divide,DC,Width,Gain,Pan,Lowpass,Highpass,Peak,Dry/wet,Stereo rectify,Stereo DC,Ring mod,Cabinet}>High Module 2 Type
slider19:gr_hi_v2=0<0,1,0.001>High Module 2 Value
slider20:gr_hi_g=0.5<0,1,0.001>High Gain
slider21:gr_x1=0.25<0,1,0.001>Low Mid Crossover
slider22:gr_x2=0.5<0,1,0.001>High Mid Crossover
slider23:gr_x3=0.75<0,1,0.001>High Crossover
slider24:gr_wet=1<0,1,0.001>Wet
slider25:gr_q=0<0,1,1{Off,On}>Quality

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
// memoire : 0..99 tables (types 0..7, valeurs 8..15, gains 16..19, dernier type 24..31, bande a continu 32..35) ; coefficients des crossovers a 100 ; etats a 1000 ; modules a 4000
gr_T = 0;                         // gr_T[b*2+m] = type, gr_T[8 + b*2+m] = valeur, gr_T[16+b] = gain lineaire
gr_XC = 100;                      // 3 crossovers x (LP 5 coefs, HP 5 coefs, AP 5 coefs) = 45
gr_XS = 1000;                     // etats des biquads : 2 canaux x 15 biquads x 2
gr_MC = 4000;                     // coefficients de module : 8 modules x 8
gr_MS = 5000;                     // etats de module : 8 modules x 2 canaux x 8
gr_DC = 6000;                     // DC bloqueur : 4 bandes x 2 canaux x 2
gr_sr = 0;

function gr_tanh(z) local(t) ( z = max(-20, min(20, z)); t = exp(2 * z); (t - 1) / (t + 1); );
function gr_set(p, b0, b1, b2, a0, a1, a2) ( p[0] = b0 / a0; p[1] = b1 / a0; p[2] = b2 / a0; p[3] = a1 / a0; p[4] = a2 / a0; );
function gr_rbj(p, kind, f, q, gdb) local(w, c, s, al, A) (
  w = 2 * $pi * max(10, min(f, 0.45 * srate)) / srate; c = cos(w); s = sin(w); al = s / (2 * q); A = 10 ^ (gdb / 40);
  kind == 0 ? gr_set(p, (1 - c) / 2, 1 - c, (1 - c) / 2, 1 + al, -2 * c, 1 - al) :          // passe-bas
  kind == 1 ? gr_set(p, (1 + c) / 2, -(1 + c), (1 + c) / 2, 1 + al, -2 * c, 1 - al) :       // passe-haut
  kind == 2 ? gr_set(p, 1 - al, -2 * c, 1 + al, 1 + al, -2 * c, 1 - al) :                   // passe-tout
              gr_set(p, 1 + al * A, -2 * c, 1 - al * A, 1 + al / A, -2 * c, 1 - al / A);    // cloche
);
// biquad (forme directe II transposee) : coefficients p, etats s
function gr_bq(x, p, s) local(y) ( y = p[0] * x + s[0]; s[0] = p[1] * x - p[3] * y + s[1]; s[1] = p[2] * x - p[4] * y; y; );

function gr_params() local(b, m, i, t, u, v, f, fc, mc, lo, hi) (
  gr_T[0] = gr_lo_m1; gr_T[1] = gr_lo_m2; gr_T[2] = gr_lm_m1; gr_T[3] = gr_lm_m2;
  gr_T[4] = gr_hm_m1; gr_T[5] = gr_hm_m2; gr_T[6] = gr_hi_m1; gr_T[7] = gr_hi_m2;
  gr_T[8] = gr_lo_v1; gr_T[9] = gr_lo_v2; gr_T[10] = gr_lm_v1; gr_T[11] = gr_lm_v2;
  gr_T[12] = gr_hm_v1; gr_T[13] = gr_hm_v2; gr_T[14] = gr_hi_v1; gr_T[15] = gr_hi_v2;
  gr_T[16] = sqr(2 * gr_lo_g); gr_T[17] = sqr(2 * gr_lm_g); gr_T[18] = sqr(2 * gr_hm_g); gr_T[19] = sqr(2 * gr_hi_g);
  // crossovers ordonnes (f1 <= f2 <= f3), f = 20 x 1000^x
  gr_f1 = 20 * 1000 ^ max(0, min(1, gr_x1));
  gr_f2 = max(gr_f1, 20 * 1000 ^ max(0, min(1, gr_x2)));
  gr_f3 = max(gr_f2, 20 * 1000 ^ max(0, min(1, gr_x3)));
  i = 0;
  loop(8,
    t = floor(gr_T[i] + 0.5);
    t != gr_T[24 + i] ? ( memset(gr_MS + i * 16, 0, 16); gr_T[24 + i] = t; );   // pas d'etat d'un autre type
    i += 1;
  );
  b = 0;
  loop(4,
    // le continu ne nait que d'Asym, Rectify, DC, Stereo rectify, Stereo DC : le bloqueur ne sert que la
    t = floor(gr_T[b * 2] + 0.5); u = floor(gr_T[b * 2 + 1] + 0.5);
    gr_T[32 + b] = (t == 4 || t == 5 || t == 11 || t == 19 || t == 20 || u == 4 || u == 5 || u == 11 || u == 19 || u == 20);
    b += 1;
  );
  gr_dcc = exp(-2 * $pi * 10 / srate);             // 10 Hz, quel que soit srate
  i = 0;
  loop(3,
    f = i == 0 ? gr_f1 : i == 1 ? gr_f2 : gr_f3;
    gr_rbj(gr_XC + i * 15, 0, f, 0.7071, 0);
    gr_rbj(gr_XC + i * 15 + 5, 1, f, 0.7071, 0);
    gr_rbj(gr_XC + i * 15 + 10, 2, f, 0.7071, 0);   // LR4 passe-bas + passe-haut = ce passe-tout du 2e ordre
    i += 1;
  );
  // coefficients des modules a filtre, au centre geometrique de leur bande
  b = 0;
  loop(4,
    lo = b == 0 ? 20 : b == 1 ? gr_f1 : b == 2 ? gr_f2 : gr_f3;
    hi = b == 0 ? gr_f1 : b == 1 ? gr_f2 : b == 2 ? gr_f3 : 20000;
    m = 0;
    loop(2,
      i = b * 2 + m; t = floor(gr_T[i] + 0.5); v = gr_T[8 + i]; mc = gr_MC + i * 8;
      t == 15 ? ( fc = 20000 * 0.001 ^ v; mc[5] = exp(-2 * $pi * min(fc, 0.45 * srate) / srate); );   // Lowpass
      t == 16 ? ( fc = 20 * 1000 ^ v; mc[5] = exp(-2 * $pi * min(fc, 0.45 * srate) / srate); );       // Highpass
      t == 17 ? gr_rbj(mc, 3, sqrt(lo * hi), 2, 24 * v);                                              // Peak
      t == 21 ? ( mc[5] = 2 * $pi * (20 * 1000 ^ v) / srate; );                                       // Ring mod
      t == 22 ? ( mc[5] = exp(-2 * $pi * 90 / srate);                                                 // Cabinet
                  mc[6] = exp(-2 * $pi * min(6000 - 4500 * v, 0.45 * srate) / srate); );
      m += 1;
    );
    b += 1;
  );
);

function gr_reset() ( memset(gr_XS, 0, 60); memset(gr_MS, 0, 128); memset(gr_DC, 0, 16); );

// UN module sur les deux canaux d'une bande : entree gr_l, gr_r (et gr_bl, gr_br = la bande avant ses modules)
function gr_mod(i) local(t, v, d, n, s, sl, sr, mc, m, o, g, gl, grr, u) (
  t = floor(gr_T[i] + 0.5); v = gr_T[8 + i]; mc = gr_MC + i * 8;
  sl = gr_MS + i * 16; sr = sl + 8;
  t == 1 ? ( d = 1 + 29 * v * v; n = 1 / sqrt(d); gr_l = gr_tanh(d * gr_l) * n; gr_r = gr_tanh(d * gr_r) * n; ) :
  t == 2 ? ( d = 1 + 29 * v * v; n = 1 / sqrt(d); gr_l = max(-1, min(1, d * gr_l)) * n; gr_r = max(-1, min(1, d * gr_r)) * n; ) :
  t == 3 ? ( d = 1 + 99 * v * v; n = 1 / sqrt(d);
             gr_l = sign(gr_l) * (1 - exp(-d * abs(gr_l))) * n; gr_r = sign(gr_r) * (1 - exp(-d * abs(gr_r))) * n; ) :
  t == 4 ? ( d = 1 + 19 * v * v; n = 1 / sqrt(d); o = 0.4 * v;
             gr_l = (gr_tanh(d * (gr_l + o)) - gr_tanh(d * o)) * n; gr_r = (gr_tanh(d * (gr_r + o)) - gr_tanh(d * o)) * n; ) :
  t == 5 ? ( gr_l = gr_l * (1 - v) + abs(gr_l) * v; gr_r = gr_r * (1 - v) + abs(gr_r) * v; ) :
  t == 6 ? ( g = 1 + 19 * v; n = 1 / sqrt(g);
             u = g * gr_l + 1; u -= 4 * floor(u / 4); gr_l = ((u < 2) ? u : 4 - u) - 1; gr_l *= n;
             u = g * gr_r + 1; u -= 4 * floor(u / 4); gr_r = ((u < 2) ? u : 4 - u) - 1; gr_r *= n; ) :
  t == 7 ? ( g = 1 + 19 * v; n = 1 / sqrt(g); gr_l = sin(g * gr_l * $pi / 2) * n; gr_r = sin(g * gr_r * $pi / 2) * n; ) :
  t == 8 ? ( o = 0.3 * v * v; n = 1 / (1 - o);
             gr_l = sign(gr_l) * max(abs(gr_l) - o, 0) * n; gr_r = sign(gr_r) * max(abs(gr_r) - o, 0) * n; ) :
  t == 9 ? ( n = 2 ^ (15 - 15 * v); gr_l = floor(gr_l * n + 0.5) / n; gr_r = floor(gr_r * n + 0.5) / n; ) :
  t == 10 ? ( d = 1 + floor(63 * v * v);                              // compteur et tenue en 7, 6, 5 : aucun
              sl[7] += 1; sl[7] >= d ? ( sl[7] = 0; sl[6] = gr_l; sl[5] = gr_r; );   // filtre ne s'en sert
              gr_l = sl[6]; gr_r = sl[5]; ) :
  t == 11 ? ( o = 2 * v - 1; o = o * o * o * o * o * 0.5; gr_l += o; gr_r += o; ) :
  t == 12 ? ( m = 0.5 * (gr_l + gr_r); s = 0.5 * (gr_l - gr_r) * 2 * v; gr_l = m + s; gr_r = m - s; ) :
  t == 13 ? ( g = sqr(v / 0.35); gr_l *= g; gr_r *= g; ) :
  t == 14 ? ( gl = min(1, 2 * (1 - v)); grr = min(1, 2 * v); gr_l *= gl; gr_r *= grr; ) :
  t == 15 ? ( sl[0] = gr_l + mc[5] * (sl[0] - gr_l); gr_l = sl[0]; sr[0] = gr_r + mc[5] * (sr[0] - gr_r); gr_r = sr[0]; ) :
  t == 16 ? ( sl[0] = gr_l + mc[5] * (sl[0] - gr_l); gr_l -= sl[0]; sr[0] = gr_r + mc[5] * (sr[0] - gr_r); gr_r -= sr[0]; ) :
  t == 17 ? ( gr_l = gr_bq(gr_l, mc, sl); gr_r = gr_bq(gr_r, mc, sr); ) :
  t == 18 ? ( gr_l = gr_bl * (1 - v) + gr_l * v; gr_r = gr_br * (1 - v) + gr_r * v; ) :
  t == 19 ? ( gr_r = gr_r * (1 - v) + abs(gr_r) * v; ) :
  t == 20 ? ( o = 2 * v - 1; o = o * o * o * o * o * 0.5; gr_l += o; gr_r -= o; ) :
  t == 21 ? ( sl[4] += mc[5]; sl[4] > 2 * $pi ? sl[4] -= 2 * $pi; g = sin(sl[4]); gr_l *= g; gr_r *= g; ) :
  t == 22 ? ( sl[1] = gr_l + mc[5] * (sl[1] - gr_l); gr_l -= sl[1];          // passe-haut 90 Hz
              sl[2] = gr_l + mc[6] * (sl[2] - gr_l); sl[3] = sl[2] + mc[6] * (sl[3] - sl[2]); gr_l = sl[3];
              sr[1] = gr_r + mc[5] * (sr[1] - gr_r); gr_r -= sr[1];
              sr[2] = gr_r + mc[6] * (sr[2] - gr_r); sr[3] = sr[2] + mc[6] * (sr[3] - sr[2]); gr_r = sr[3]; );
);

// une bande : ses deux modules, son DC bloqueur, son gain
function gr_band(b) local(p) (
  gr_bl = gr_l; gr_br = gr_r;
  gr_mod(b * 2); gr_mod(b * 2 + 1);
  gr_T[32 + b] ? (                                 // y = x - x1 + c y1 (10 Hz), par canal
    p = gr_DC + b * 4;
    p[1] = gr_l - p[0] + gr_dcc * p[1]; p[0] = gr_l; gr_l = p[1];
    p[3] = gr_r - p[2] + gr_dcc * p[3]; p[2] = gr_r; gr_r = p[3];
  );
  gr_l *= gr_T[16 + b]; gr_r *= gr_T[16 + b];
);

gr_params(); gr_reset(); gr_sr = srate;
gr_last = time_precise();

@slider
gr_params();

@block
srate != gr_sr ? ( gr_sr = srate; gr_params(); gr_reset(); );
gr_now = time_precise();
gr_now - gr_last > 0.15 ? gr_reset();              // retour de bypass : filtres, tenues et phases repartent de zero
gr_last = gr_now;

@sample
gr_dl = spl0; gr_dr = spl1;
// separation 4 bandes : Linkwitz-Riley 4 (deux Butterworth en cascade), compensee en phase par des passe-tout
// (canal c : etats a gr_XS + c*30 ; crossover i : LP 2 biquads, HP 2 biquads, AP 1 biquad -> 10 etats)
gr_c = 0;
loop(2,
  gr_x = gr_c ? gr_dr : gr_dl;
  gr_s = gr_XS + gr_c * 30;
  gr_b0 = gr_bq(gr_bq(gr_x, gr_XC, gr_s), gr_XC, gr_s + 2);              gr_r1 = gr_bq(gr_bq(gr_x, gr_XC + 5, gr_s + 4), gr_XC + 5, gr_s + 6);
  gr_b1 = gr_bq(gr_bq(gr_r1, gr_XC + 15, gr_s + 10), gr_XC + 15, gr_s + 12); gr_r2 = gr_bq(gr_bq(gr_r1, gr_XC + 20, gr_s + 14), gr_XC + 20, gr_s + 16);
  gr_b2 = gr_bq(gr_bq(gr_r2, gr_XC + 30, gr_s + 20), gr_XC + 30, gr_s + 22); gr_b3 = gr_bq(gr_bq(gr_r2, gr_XC + 35, gr_s + 24), gr_XC + 35, gr_s + 26);
  gr_b0 = gr_bq(gr_bq(gr_b0, gr_XC + 25, gr_s + 8), gr_XC + 40, gr_s + 18);  // grave : passe-tout de f2 puis f3
  gr_b1 = gr_bq(gr_b1, gr_XC + 40, gr_s + 28);                              // bas-medium : passe-tout de f3
  gr_c ? ( gr_B0r = gr_b0; gr_B1r = gr_b1; gr_B2r = gr_b2; gr_B3r = gr_b3; )
       : ( gr_B0l = gr_b0; gr_B1l = gr_b1; gr_B2l = gr_b2; gr_B3l = gr_b3; );
  gr_c += 1;
);
gr_l = gr_B0l; gr_r = gr_B0r; gr_band(0); gr_sl = gr_l; gr_sr2 = gr_r;
gr_l = gr_B1l; gr_r = gr_B1r; gr_band(1); gr_sl += gr_l; gr_sr2 += gr_r;
gr_l = gr_B2l; gr_r = gr_B2r; gr_band(2); gr_sl += gr_l; gr_sr2 += gr_r;
gr_l = gr_B3l; gr_r = gr_B3r; gr_band(3); gr_sl += gr_l; gr_sr2 += gr_r;
spl0 = gr_dl * (1 - gr_wet) + gr_sl * gr_wet;
spl1 = gr_dr * (1 - gr_wet) + gr_sr2 * gr_wet;
