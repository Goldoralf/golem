desc:GoleM Phaser -- the phaser block on Windows and macOS (Calf Phaser parameters)
// SPDX-License-Identifier: MIT
// Copyright (C) 2026 Raphaël Mucchielli, Grégory Beurier and contributors
// Ce JSFX est sous MIT, PAS sous la GPL du depot : un effet doit pouvoir voyager seul.
//
// Le bloc « phaser » joue Calf Phaser sous Linux ; Calf n'existe ni sous Windows ni sous macOS (docs/platforms.md
// §5). Ce JSFX reprend ses NOMS de parametres, leurs BORNES et leurs DEFAUTS natifs (src/metadata.cpp de Calf, lu
// le 2026-10-22) pour que la table de l'OS le nomme sans toucher un preset. L'ARCHITECTURE est celle, publique,
// d'un phaser a passe-tout d'ordre 1 en cascade (Calf simple_phaser : N etages, retour d'etat, LFO triangle
// sur la frequence en cents, coefficients rafraichis tous les 32 echantillons, canal droit decale de STEREO degres).
// Le CODE est le notre.
//
//  - Center Freq   : frequence centrale (Hz), autour de laquelle le LFO balaie.
//  - Mod depth     : amplitude du balayage en CENTS (4000 = +/- 3,3 octaves), comme Calf.
//  - Mod rate      : vitesse du LFO (Hz).
//  - Feedback      : retour du dernier etage vers l'entree (-0.99..0.99 : plage SYMETRIQUE, le taper bipolaire
//                    de REAPER y est la meme droite que la lineaire).
//  - # Stages      : nombre de passe-tout (1..12 ; le catalogue ecrit 4, 6, 8 ou 12).
//  - Stereo phase  : decalage du LFO droit (degres).
//  - Amount / Dry Amount : niveaux de l'effet et du direct (defauts Calf 0,5 et 1,0).
//
// Pieges respectes : rien avant @init ; variables prefixees ph_ ; ext_noinit ; pas de nom qui ne differe que par
// la casse ; pas de litteral exponentiel (EEL2 ne les lit pas).

slider1:ph_freq=1000<20,20000,1>Center Freq
slider2:ph_depth=4000<0,10800,1>Mod depth
slider3:ph_rate=0.1<0.01,20,0.01>Mod rate
slider4:ph_fb=0.5<-0.99,0.99,0.01>Feedback
slider5:ph_stages=6<1,12,1># Stages
slider6:ph_stereo=180<0,360,1>Stereo phase
slider7:ph_amount=0.5<0,4,0.01>Amount
slider8:ph_dry=1<0,4,0.01>Dry Amount

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
ph_MAXST = 12;
ph_x1 = 0;                 // 2 canaux x 12 etages : x1 a 0..23, y1 a 32..55
ph_y1 = 32;
ph_state = 64;             // 2 : le retour d'etat par canal
ph_phase = 0;              // phase du LFO gauche (0..1)
ph_cnt = 31;               // les coefficients se calculent des le premier echantillon (Calf : control_step() dans reset())
ph_a0l = 0; ph_a0r = 0;
ph_nst = 6;

// LFO triangle de Calf (control_step : phase + 0x40000000, pliee) : 0 en phase 0, +1 au quart, 0 a la moitie, -1 aux trois quarts
function ph_tri(p) local(q) (
  q = p + 0.25 - floor(p + 0.25);
  q < 0.5 ? (4 * q - 1) : (3 - 4 * q);
);

// coefficient du passe-tout pour une frequence (Calf : x = tan(f * pi/2 / sr), a0 = (x - 1) / (1 + x))
function ph_apcoef(f) local(x) (
  f = max(10, min(0.49 * srate, f));
  x = tan(f * $pi / 2 / srate);
  (x - 1) / (1 + x);
);

// un canal : retour, N passe-tout en cascade (out = (in - y1) * a0 + x1), etat memorise
function ph_chan(x, ch, a0) local(fd, i, b, o) (
  fd = x + ph_state[ch] * ph_fb;
  b = ch * ph_MAXST;
  i = 0;
  loop(ph_nst,
    o = (fd - ph_y1[b + i]) * a0 + ph_x1[b + i];
    ph_x1[b + i] = fd;
    ph_y1[b + i] = o;
    fd = o;
    i += 1;
  );
  ph_state[ch] = fd;
  fd;
);

@slider
ph_nst = max(1, min(ph_MAXST, floor(ph_stages + 0.5)));
ph_dph = ph_rate / srate * 32;                                   // la phase avance tous les 32 echantillons, comme Calf
ph_roff = ph_stereo / 360;

@block
ph_dph = ph_rate / srate * 32;

@sample
ph_cnt += 1;
ph_cnt >= 32 ? (
  ph_cnt = 0;
  ph_a0l = ph_apcoef(ph_freq * 2 ^ (ph_tri(ph_phase) * ph_depth / 1200));
  ph_a0r = ph_apcoef(ph_freq * 2 ^ (ph_tri(ph_phase + ph_roff) * ph_depth / 1200));
  ph_phase += ph_dph; ph_phase >= 1 ? ph_phase -= 1;
  // denormaux : l'etat de CHAQUE passe-tout qui s'eteint (Calf sanitize x1/y1/state a chaque control_step)
  ph_k = 0;
  loop(2 * ph_MAXST,
    abs(ph_x1[ph_k]) < 0.000000000000001 ? ph_x1[ph_k] = 0;
    abs(ph_y1[ph_k]) < 0.000000000000001 ? ph_y1[ph_k] = 0;
    ph_k += 1;
  );
  abs(ph_state[0]) < 0.000000000000001 ? ph_state[0] = 0;
  abs(ph_state[1]) < 0.000000000000001 ? ph_state[1] = 0;
);
ph_wl = ph_chan(spl0, 0, ph_a0l);
ph_wr = ph_chan(spl1, 1, ph_a0r);
spl0 = ph_dry * spl0 + ph_amount * ph_wl;
spl1 = ph_dry * spl1 + ph_amount * ph_wr;
